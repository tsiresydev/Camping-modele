# Configuration Google Drive pour la section "Saréba" (musique)
# Ces variables sont exposées côté client : restreignez la clé dans Google Cloud
# (restriction HTTP referrer + API Drive uniquement) ou utilisez un proxy serveur.
VITE_GOOGLE_DRIVE_API_KEY=
VITE_GOOGLE_DRIVE_FOLDER_ID=

# Configuration Google Drive pour la section "Documents"
# Même clé API que la musique (côté client, à restreindre dans Google Cloud).
VITE_GOOGLE_DRIVE_DOCUMENTS_FOLDER_ID=
